@model IEnumerable<GearsHouse.Models.Product>
@inject GearsHouse.Repositories.ICategoryRepository _categoryRepository
@inject GearsHouse.Repositories.IBrandRepository _brandRepository
@{
    ViewData["Title"] = ViewBag.SelectedCategory ?? "Tất cả sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categories = await _categoryRepository.GetAllAsync();
    var brands = await _brandRepository.GetAllAsync();
}

@section Styles {
    <style>
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: #f7f7f9;
            color: #333;
        }

        /* Container chính */
        .container.my-4 {
            max-width: 1200px;
        }

        /* Sidebar */
        .sidebar-card {
            border: 2px solid #ff6600;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(255, 102, 0, 0.15);
            background: linear-gradient(135deg, #fff7f0, #fff0e6);
            transition: box-shadow 0.3s ease;
        }

        .sidebar-card:hover { box-shadow: 0 12px 36px rgba(255, 102, 0, 0.3); }

        .filter-group-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }

        .input-group .input-group-text { background-color: #fff; }

        .quick-price-chips { display: flex; flex-wrap: wrap; gap: 8px; }
        .quick-chip {
            border: 1px solid #ff6600;
            color: #ff6600;
            padding: 4px 10px;
            border-radius: 999px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.2s ease;
            background: #fff;
        }
        .quick-chip:hover { background: #ffefe6; }

        .active-filters { display: none; }
        .filter-badge {
            background-color: #fff7f0;
            color: #cc5200;
            border: 1px solid #ff6600;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 0.85rem;
            margin-right: 8px;
        }

        /* Product card */
        .product-card {
            border: none;
            border-radius: 16px;
            padding: 16px;
            background: linear-gradient(to bottom right, #ffffff, #f9f9f9);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
            transition: all 0.3s ease-in-out;
            height: 100%;
            display: flex;
            flex-direction: column;
            position: relative;
        }

            .product-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 16px 36px rgba(255, 102, 0, 0.25);
            }

        .card-img-wrapper {
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            border-radius: 12px;
            background-color: #fff7f1;
            overflow: hidden;
            transition: background-color 0.3s ease;
            position: relative;
        }

        .product-card:hover .card-img-wrapper {
            background-color: #ffe6d1;
        }

        .card-img-top {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .product-card:hover .card-img-top {
            transform: scale(1.1);
        }

        /* Button outline primary */
        .btn-outline-primary {
            color: #ff6600;
            border: 2px solid #ff6600;
            font-weight: 600;
            font-size: 16px;
            padding: 10px 24px;
            border-radius: 10px;
            background-color: transparent;
            transition: all 0.3s ease;
            box-shadow: 0 0 0 rgba(255, 102, 0, 0);
        }

            .btn-outline-primary:hover {
                background-color: #ff6600;
                color: white;
                border-color: #ff6600;
                box-shadow: 0 0 12px rgba(255, 102, 0, 0.6);
            }

        /* Breadcrumb */
        .breadcrumb-item a {
            color: #555;
            font-weight: 600;
            transition: color 0.3s ease;
        }

            .breadcrumb-item a:hover {
                color: #ff6600;
                text-decoration: underline;
            }

        h2.text-primary {
            color: #ff6600 !important;
            text-shadow: 1px 1px 3px rgba(255, 102, 0, 0.4);
        }

        /* Card body title */
        .card-body h5 {
            font-weight: 700;
            font-size: 18px;
            color: #222;
            min-height: 48px;
            /* Đảm bảo chiều cao cố định */
        }

        /* Giá sản phẩm */
        .text-danger {
            color: #ff3d00 !important;
            font-weight: 700;
            font-size: 1.15rem;
        }

        .badge.bg-danger {
            background-color: #ff6600 !important;
            font-size: 0.85rem;
            padding: 4px 8px;
            border-radius: 8px;
        }

        /* Card chung */
        .card {
            border-radius: 12px;
            border: none;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
        }

        /* Form input focus */
        .form-select:focus,
        .form-control:focus {
            border-color: #ff6600;
            box-shadow: 0 0 0 0.25rem rgba(255, 102, 0, 0.35);
            outline: none;
            transition: box-shadow 0.3s ease, border-color 0.3s ease;
        }

        /* Button primary */
        .btn-primary {
            background-color: #ff6600;
            border-color: #ff6600;
            font-weight: 600;
            transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .btn-primary:hover {
                background-color: #e05500;
                border-color: #e05500;
                box-shadow: 0 0 15px rgba(224, 85, 0, 0.6);
            }

        /* Thông báo không có sản phẩm */
        .no-products-message {
            font-weight: 500;
            background-color: #fff3e6;
            color: #cc5200;
            border-left: 4px solid #ff6600;
            padding: 12px;
            border-radius: 6px;
            font-size: 1.1rem;
            text-align: center;
            box-shadow: 0 4px 12px rgba(255, 102, 0, 0.15);
        }

        /* Icon cho tiêu đề */
        .filter-title i,
        .search-title i {
            font-size: 1.2rem;
            margin-right: 8px;
            color: #ff6600;
            vertical-align: middle;
        }

        /* Responsive cho input tìm kiếm */
        #searchKeyword {
            transition: box-shadow 0.3s ease;
        }

            #searchKeyword:focus {
                box-shadow: 0 0 10px #ff6600;
            }

        /* Animation nhẹ cho nút */
        button#applySearch,
        button#applyFilter {
            position: relative;
            overflow: hidden;
        }

            button#applySearch::after,
            button#applyFilter::after {
                content: '';
                position: absolute;
                left: 50%;
                top: 50%;
                width: 0;
                height: 0;
                background: rgba(255, 102, 0, 0.4);
                border-radius: 100%;
                transform: translate(-50%, -50%);
                transition: width 0.4s ease, height 0.4s ease;
                z-index: 0;
            }

            button#applySearch:hover::after,
            button#applyFilter:hover::after {
                width: 200%;
                height: 500%;
            }

        /* Card hover nâng cao */
        .product-card:hover {
            cursor: pointer;
        }

        .discount-badge { font-weight: 700; }

        .card-actions {
            position: absolute;
            bottom: 8px;
            left: 8px;
            right: 8px;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .product-card:hover .card-actions { opacity: 1; }
    </style>
}

<div class="container my-4">
    <!-- Keyword từ query để tự động áp dụng tìm kiếm -->
    <input type="hidden" id="initialKeyword" value="@Context.Request.Query["keyword"].ToString()" />
    <h2 class="text-uppercase text-center text-primary mb-4 fw-bold">@ViewData["Title"]</h2>

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i> Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Sidebar bộ lọc -->
        <div class="col-lg-3">

            <div class="card sidebar-card">
                <div class="card-body">
                    <h6 class="filter-title fw-semibold"><i class="bi bi-funnel-fill"></i> Lọc sản phẩm</h6>
                    <form id="filterForm" autocomplete="off">
                        <div class="mb-3">
                            <label for="categoryFilter" class="filter-group-label"><i class="bi bi-list-ul"></i> Danh mục</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-list-ul"></i></span>
                                <select id="categoryFilter" class="form-select" aria-label="Lọc theo danh mục">
                                    <option value="">Tất cả danh mục</option>
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="brandFilter" class="filter-group-label"><i class="bi bi-tags"></i> Thương hiệu</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-tags"></i></span>
                                <select id="brandFilter" class="form-select" aria-label="Lọc theo thương hiệu">
                                    <option value="">Tất cả thương hiệu</option>
                                    @foreach (var brand in brands)
                                    {
                                        <option value="@brand.BrandId">@brand.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="filter-group-label"><i class="bi bi-cash-coin"></i> Khoảng giá (VND)</label>
                            <div class="row g-2 mb-2">
                                <div class="col">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bi bi-arrow-down"></i></span>
                                        <input type="number" id="minPrice" class="form-control" placeholder="Tối thiểu" aria-label="Giá tối thiểu">
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bi bi-arrow-up"></i></span>
                                        <input type="number" id="maxPrice" class="form-control" placeholder="Tối đa" aria-label="Giá tối đa">
                                    </div>
                                </div>
                            </div>
                            <div class="quick-price-chips">
                                <span class="quick-chip" data-min="0" data-max="1000000">Dưới 1 triệu</span>
                                <span class="quick-chip" data-min="1000000" data-max="5000000">1–5 triệu</span>
                                <span class="quick-chip" data-min="5000000" data-max="10000000">5–10 triệu</span>
                                <span class="quick-chip" data-min="10000000" data-max="999999999">Trên 10 triệu</span>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" type="button" id="applyFilter" aria-label="Áp dụng bộ lọc">
                                <i class="bi bi-funnel"></i> Áp dụng
                            </button>
                            <button class="btn btn-outline-secondary" type="button" id="clearFilter" aria-label="Xóa bộ lọc">
                                <i class="bi bi-x-circle"></i> Xóa lọc
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-lg-9">
            <!-- Chip hiển thị bộ lọc đang áp dụng -->
            <div id="activeFilters" class="active-filters mb-3">
                <span class="filter-badge" id="afCategory" style="display:none;"></span>
                <span class="filter-badge" id="afBrand" style="display:none;"></span>
                <span class="filter-badge" id="afPrice" style="display:none;"></span>
            </div>
            <div class="alert alert-warning no-products-message" style="display: none;">
                <i class="bi bi-exclamation-triangle-fill"></i> Không tìm thấy sản phẩm
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @foreach (var product in Model)
                {
                    <div class="col product-item"
                         data-name="@product.Name.ToLower()"
                         data-category="@product.CategoryId"
                         data-brand="@product.BrandId"
                         data-price="@product.Price">
                        <div class="card product-card" tabindex="0" role="link" aria-label="Xem chi tiết sản phẩm @product.Name">
                            <div class="card-img-wrapper">
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" loading="lazy">
                                @if (ViewBag.ProductDiscounts?.ContainsKey(product.Id) == true)
                                {
                                    var discountData = ((decimal price, int percent))ViewBag.ProductDiscounts[product.Id];
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2 discount-badge">-@discountData.percent%</span>
                                }
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@product.Name</h5>
                                @{ var brandName = (brands?.FirstOrDefault(b => b.BrandId == product.BrandId)?.Name) ?? string.Empty; }
                                @{ var categoryName = (categories?.FirstOrDefault(c => c.Id == product.CategoryId)?.Name) ?? string.Empty; }
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    @if (!string.IsNullOrEmpty(brandName)) { <span class="badge bg-light text-dark border">@brandName</span> }
                                    @if (!string.IsNullOrEmpty(categoryName)) { <span class="badge bg-light text-dark border">@categoryName</span> }
                                </div>
                                @if (ViewBag.ProductDiscounts?.ContainsKey(product.Id) == true)
                                {
                                    var discount = ((decimal price, int percent))ViewBag.ProductDiscounts[product.Id];
                                    <p class="text-muted text-decoration-line-through">@string.Format("{0:N0} đ", product.Price)</p>
                                    <p class="text-danger fw-bold">@string.Format("{0:N0} đ", discount.price) <span class="badge bg-danger">-@discount.percent%</span></p>
                                }
                                else
                                {
                                    <p class="text-dark fw-semibold">@string.Format("{0:N0} đ", product.Price)</p>
                                }
                                <a asp-action="Display" asp-route-id="@product.Id" class="stretched-link" aria-label="Xem chi tiết sản phẩm @product.Name"></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function checkNoProductsFound() {
                var visibleProducts = $(".product-item:visible").length;
                $(".no-products-message").toggle(visibleProducts === 0);
            }

            function parsePrice(value, defaultValue) {
                var parsed = parseFloat(value);
                return (isNaN(parsed) || parsed < 0) ? defaultValue : parsed;
            }

            function updateActiveFilters() {
                var categoryText = $("#categoryFilter option:selected").text();
                var categoryVal = $("#categoryFilter").val();
                var brandText = $("#brandFilter option:selected").text();
                var brandVal = $("#brandFilter").val();
                var minPrice = $("#minPrice").val();
                var maxPrice = $("#maxPrice").val();

                var any = false;
                if (categoryVal) {
                    $("#afCategory").text("Danh mục: " + categoryText).show();
                    any = true;
                } else { $("#afCategory").hide(); }

                if (brandVal) {
                    $("#afBrand").text("Thương hiệu: " + brandText).show();
                    any = true;
                } else { $("#afBrand").hide(); }

                if (minPrice || maxPrice) {
                    var priceLabel = "Giá";
                    if (minPrice && maxPrice) priceLabel += ": " + Number(minPrice).toLocaleString() + " - " + Number(maxPrice).toLocaleString();
                    else if (minPrice) priceLabel += ": từ " + Number(minPrice).toLocaleString();
                    else if (maxPrice) priceLabel += ": đến " + Number(maxPrice).toLocaleString();
                    $("#afPrice").text(priceLabel).show();
                    any = true;
                } else { $("#afPrice").hide(); }

                $("#activeFilters").toggle(any);
            }

            function applyFilters() {
                var keywordInput = $("#searchKeyword");
                var keyword = keywordInput.length ? keywordInput.val().toLowerCase().trim() : $("#initialKeyword").val().toLowerCase().trim();
                var categoryIdStr = $("#categoryFilter").val();
                var brandIdStr = $("#brandFilter").val();
                var minPrice = parsePrice($("#minPrice").val(), 0);
                var maxPrice = parsePrice($("#maxPrice").val(), Number.MAX_SAFE_INTEGER);

                $(".product-item").each(function () {
                    var $item = $(this);
                    var name = $item.data("name") || "";
                    var category = $item.data("category")?.toString() || "";
                    var brand = $item.data("brand")?.toString() || "";
                    var price = parseFloat($item.data("price")) || 0;

                    var matchesKeyword = !keyword || name.includes(keyword);
                    var matchesCategory = !categoryIdStr || category === categoryIdStr;
                    var matchesBrand = !brandIdStr || brand === brandIdStr;
                    var matchesPrice = (price >= minPrice && price <= maxPrice);

                    if (matchesKeyword && matchesCategory && matchesBrand && matchesPrice) {
                        $item.show();
                    } else {
                        $item.hide();
                    }
                });
                checkNoProductsFound();
                updateActiveFilters();
            }

            $("#applyFilter").click(applyFilters);

            $("#clearFilter").click(function(){
                $("#categoryFilter").val("");
                $("#brandFilter").val("");
                $("#minPrice").val("");
                $("#maxPrice").val("");
                applyFilters();
            });

            $(document).on('click', '.quick-chip', function(){
                var min = $(this).data('min');
                var max = $(this).data('max');
                $("#minPrice").val(min);
                $("#maxPrice").val(max);
                applyFilters();
            });

            // Nếu có keyword từ query, tự động đặt và áp dụng bộ lọc
            var initialKeyword = $("#initialKeyword").val();
            if (initialKeyword && initialKeyword.trim().length > 0) {
                applyFilters();
            }
        });
    </script>
}
 