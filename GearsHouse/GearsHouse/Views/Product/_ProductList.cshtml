@model IEnumerable<GearsHouse.Models.Product>

<div id="productContainer" class="row g-4">
    @if (!Model.Any())
    {
        <p class="text-center text-muted fs-5 mt-5">Không tìm thấy sản phẩm nào.</p>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 col-xl-3 product-item fade-in"
                 data-category="@item.CategoryId"
                 data-brand="@item.BrandId"
                 data-name="@item.Name"
                 data-price="@item.Price">
                <div class="card product-card border-0 shadow-sm">
                    <div class="card-img-wrapper">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" />
                        @if (item.Quantity == 0)
                        {
                            <span class="badge bg-secondary position-absolute top-0 start-0 m-2">Hết hàng</span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-dark">@item.Name</h5>
                        @if (item.Quantity == 0)
                        {
                            <p class="text-danger fw-bold">Hết hàng</p>
                        }
                        else
                        {
                            <p class="card-text">@item.Price.ToString("#,##0") VND</p>
                        }
                        <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="btn btn-primary btn-sm mt-auto">
                            <i class="bi bi-eye-fill me-1"></i>Xem chi tiết
                        </a>
                    </div>
                </div>  
            </div>
        }
    }
</div>

<style>
    /* Reset */
    * {
        box-sizing: border-box;
    }

    /* Typography chỉ áp dụng cho khu vực sản phẩm, tránh ảnh hưởng navbar */
    .product-item,
    .product-item * {
        font-family: 'Poppins', sans-serif;
    }

    /* Container */
    .container {
        max-width: 1300px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Card sản phẩm */
    .product-card {
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        background: #fff;
    }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }

    .card-img-wrapper {
        position: relative;
        overflow: hidden;
        height: 250px; /* Chiều cao cố định để đồng bộ */
    }

    .card-img-top {
        width: 100%;
        height: 100%;
        object-fit: cover; /* Đảm bảo ảnh không bị méo */
        transition: transform 0.4s ease;
    }

    .product-card:hover .card-img-top {
        transform: scale(1.05); /* Zoom nhẹ khi hover */
    }

    .card-body {
        padding: 20px;
    }

    .card-title {
        font-size: 1.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis; /* Cắt ngắn tên nếu quá dài */
    }

    .card-text {
        color: #666;
        font-weight: 500;
    }

    /* Nút Xem chi tiết */
    .btn-primary {
        background: linear-gradient(135deg, #ff5722, #ff9800);
        border: none;
        border-radius: 10px;
        padding: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #ff9800, #ff5722);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 87, 34, 0.4);
        }
</style>