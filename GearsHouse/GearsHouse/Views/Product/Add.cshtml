@model GearsHouse.Models.Product
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Add Product";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-5 animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-orange border-3 rounded-4">
                <div class="card-header bg-orange text-white text-center rounded-top">
                    <h3 class="mb-0"><i class="fas fa-box-open me-2"></i>THÊM SẢN PHẢM </h3>
                </div>
                <div class="card-body p-4 bg-white rounded-bottom">
                    <form asp-action="Add" method="post" enctype="multipart/form-data" novalidate id="form-add-product">
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="fas fa-tag me-1 text-orange"></i>NHẬP TÊN SẢN PHẨM
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Price" class="form-label fw-semibold">
                                <i class="fas fa-dollar-sign me-1 text-orange"></i>GIÁ SẢN PHẨM
                            </label>
                            <input asp-for="Price" type="number" min="0" step="0.01" class="form-control" placeholder="Enter price" autocomplete="off" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="fas fa-align-left me-1 text-orange"></i>THÔNG TIN CHI TIẾT
                            </label>
                            <textarea asp-for="Description" class="form-control" placeholder="Enter product description" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                <i class="fas fa-layer-group me-1 text-orange"></i>DANH MỤC
                            </label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Select category --</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BrandId" class="form-label fw-semibold">
                                <i class="fas fa-industry me-1 text-orange"></i>THƯƠNG HIỆU
                            </label>
                            <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                                <option value="">-- Select brand --</option>
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">
                                <i class="fas fa-image me-1 text-orange"></i>ẢNH SẢN PHẨM
                            </label>
                            <input type="file" asp-for="ImageUrl" class="form-control" id="imageInput" accept="image/*" />
                            <div class="mt-3 text-center">
                                <img id="previewImage" src="#" alt="Preview Image" class="img-preview" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-images me-1 text-orange"></i>ẢNH PHỤ (có thể chọn nhiều)
                            </label>
                            <input type="file" name="galleryImages" id="galleryInput" class="form-control" accept="image/*" multiple />
                            <div class="mt-3" id="galleryPreview" style="display:flex; gap:10px; flex-wrap:wrap;"></div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-orange px-5 py-2 shadow-sm">
                                <i class="fas fa-plus-circle me-2"></i>Add Product
                            </button>
                            <a asp-controller="Dashboard" asp-action="Dashboard" asp-route-tab="product" class="btn btn-outline-secondary ms-3">
                                <i class="fas fa-arrow-left me-1"></i>Go Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #f8f9fa;
    }

    .bg-orange {
        background-color: #fd7e14 !important;
    }

    .text-orange {
        color: #fd7e14;
    }

    .border-orange {
        border-color: #fd7e14 !important;
    }

    .btn-orange {
        background-color: #fd7e14;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        transition: background-color 0.3s ease;
    }

        .btn-orange:hover {
            background-color: #e36a0a;
        }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 10px 14px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #fd7e14;
            box-shadow: 0 0 0 0.2rem rgba(253, 126, 20, 0.25);
        }

    .img-preview {
        max-width: 250px;
        border-radius: 12px;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        display: none;
    }

        .img-preview.show {
            display: block;
        }

    .animate-fade-in {
        animation: fadeIn 0.8s ease-in-out;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<script src="https://cdn.tiny.cloud/1/mceyvkr5qw1v3d6pw7hqems6xoqgcxo582jxoxtkqhpm9cp3/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    // Preview image
    document.getElementById('imageInput').addEventListener('change', function (event) {
        const file = event.target.files[0];
        const img = document.getElementById("previewImage");
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                img.src = e.target.result;
                img.classList.add('show');
            };
            reader.readAsDataURL(file);
        } else {
            img.src = "#";
            img.classList.remove('show');
        }
    });

    // Preview gallery images
    document.getElementById('galleryInput').addEventListener('change', function (event) {
        const files = Array.from(event.target.files);
        const container = document.getElementById('galleryPreview');
        container.innerHTML = '';
        files.forEach(file => {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.maxWidth = '120px';
                img.style.borderRadius = '8px';
                img.style.boxShadow = '0 0 6px rgba(0,0,0,0.15)';
                container.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    });

    // TinyMCE config
    tinymce.init({
        selector: 'textarea',
        menubar: false,
        plugins: 'lists link image table',
        toolbar: 'undo redo | bold italic underline | alignleft aligncenter alignright | numlist bullist | link image table',
        height: 250,
        content_style: `
            body {
                font-family: 'Segoe UI', sans-serif;
                font-size: 1rem;
                color: #212529;
                background-color: #fff;
                padding: 10px;
            }
            a { color: #fd7e14; }
        `,
        setup: function (editor) {
            editor.on('change', function () {
                editor.save();
            });
        }
    });
</script>
