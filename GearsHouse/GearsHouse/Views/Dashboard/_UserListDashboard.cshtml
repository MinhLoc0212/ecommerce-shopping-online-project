@model IEnumerable<GearsHouse.Models.UserRoleViewModel>
@{
    Layout = null;
}

<h3 class="text-center text-primary mb-4 fw-bold">Quản lý Nhân viên / Vai trò</h3>

<div class="table-responsive user-table-wrapper">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th class="text-center">Họ tên</th>
                <th class="text-center">Email</th>
                <th class="text-center">Vai trò hiện tại</th>
                <th class="text-center">Chỉnh vai trò</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="text-center">@u.FullName</td>
                    <td class="text-center">@u.Email</td>
                    <td class="text-center">@(string.Join(", ", u.CurrentRoles))</td>
                    <td class="text-center">
                        <form asp-action="UpdateUserRole" asp-controller="Dashboard" method="post" class="d-inline-flex gap-2 align-items-center js-user-role-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <select name="role" class="form-select form-select-sm" style="min-width: 160px;">
                                <option value="Admin">Admin</option>
                                <option value="Employee">Employee</option>
                                <option value="Customer">Customer</option>
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-shield-lock"></i> Cập nhật
                            </button>
                        </form>
                        <form asp-action="DeleteUser" asp-controller="Dashboard" method="post" class="d-inline ms-2 js-user-delete-form" onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này? Thao tác không thể hoàn tác.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<style>
    .user-table-wrapper {
        border: 2px solid #000;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        animation: fadeIn 0.6s ease forwards;
    }

    .table th, .table td {
        vertical-align: middle;
        padding: 12px 16px;
    }

    .table-dark th {
        background-color: #343a40;
        color: #fff;
        font-weight: 600;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>