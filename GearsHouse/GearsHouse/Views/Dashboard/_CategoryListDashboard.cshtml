@model IEnumerable<GearsHouse.Models.Category>
@{
    Layout = null;
}
<h3 class="text-center text-primary mb-4 fw-bold">Danh sách Danh Mục (Dashboard)</h3>

<div class="table-responsive category-table-wrapper">
    <table class="category-table">
        <thead class="category-header">
            <tr>
                <th class="text-center"><i class="bi bi-tags me-1"></i> Tên Danh Mục</th>
                <th class="text-center"><i class="bi bi-gear me-1"></i> Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td class="text-center">@category.Name</td>
                    <td class="text-center">
                        <a href="@Url.Action("UpdateCategory", "Categories", new { id = category.Id })" class="btn btn-warning btn-sm btn-action js-edit-category">
                            <i class="bi bi-pencil-square"></i> Sửa
                        </a>
                        <form action="@Url.Action("DeleteCategory", "Categories", new { id = category.Id })" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm btn-action" onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?');">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="text-center mt-4">
    <a href="@Url.Action("AddCategory", "Categories")" class="btn btn-success btn-lg btn-add-category">
        <i class="bi bi-plus-circle me-2"></i> Thêm danh mục
    </a>
</div>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    /* Wrapper bảng với viền đen vuông */
    .category-table-wrapper {
        border: 2px solid #000;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        background: #fff;
        border-radius: 0;
        overflow: visible;
    }

    /* Bảng */
    .category-table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        border-radius: 0;
    }

    /* Header */
    .category-header {
        background-color: #212529; /* màu tối */
        color: #fff;
        font-weight: 700;
        border-bottom: 3px solid #000;
        border-radius: 0 !important;
    }

        .category-header th {
            padding: 12px 15px;
            border: 1px solid #000;
            vertical-align: middle;
            user-select: none;
            transition: background-color 0.3s ease;
        }

            .category-header th:hover {
                background-color: #343a40;
                cursor: default;
            }

    /* Các dòng tbody xen kẽ màu */
    tbody tr:nth-child(odd) {
        background-color: #f8f9fa;
        transition: background-color 0.3s ease;
    }

    tbody tr:nth-child(even) {
        background-color: #e9ecef;
        transition: background-color 0.3s ease;
    }

    tbody tr:hover {
        background-color: #d1e7dd !important;
        box-shadow: inset 0 0 10px #93c6a1;
        cursor: pointer;
    }

    /* Ô td */
    tbody td {
        padding: 12px 15px;
        border: 1px solid #000;
        vertical-align: middle;
        transition: color 0.3s ease;
    }

    /* Nút hành động */
    .btn-action {
        border-radius: 6px;
        font-weight: 600;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
    }

        .btn-action:hover {
            transform: scale(1.12) rotate(-2deg);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            background-color: #ffc107 !important; /* vàng nổi bật cho btn-warning */
            color: #000 !important;
        }

    .btn-danger.btn-action:hover {
        background-color: #dc3545 !important;
        transform: scale(1.1) rotate(2deg);
        box-shadow: 0 6px 12px rgba(220, 53, 69, 0.5);
        color: #fff !important;
    }

    /* Nút thêm danh mục */
    .btn-add-category {
        border-radius: 8px;
        font-weight: 700;
        background: linear-gradient(45deg, #28a745, #218838);
        border-color: #218838;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .btn-add-category:hover {
            transform: scale(1.15) rotate(-1deg);
            box-shadow: 0 8px 16px rgba(33, 136, 56, 0.7);
        }

    /* Icon nhỏ bên cạnh text */
    .bi {
        vertical-align: -.125em;
        margin-right: 6px;
        transition: transform 0.3s ease;
    }

    /* Icon nhảy nhẹ khi hover nút */
    .btn:hover .bi {
        transform: translateX(3px) rotate(15deg);
    }

    /* Canh giữa */
    .text-center {
        text-align: center !important;
    }
</style>
