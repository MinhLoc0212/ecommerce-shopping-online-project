@model IEnumerable<GearsHouse.Models.Order>
@using GearsHouse.Extensions
@using GearsHouse.Models
@using GearsHouse.Helpers
@{
    Layout = null;
}
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid py-5">
    <div class="card shadow-lg border-0 rounded-4 animate__animated animate__fadeInUp">
        <div class="card-header bg-primary text-white py-4 d-flex justify-content-center rounded-top-4">
            <h2 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Quản lý Đơn Hàng</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr class="order-row animate__animated animate__fadeIn">
                                <td class="ps-4 fw-semibold text-primary">@order.Id</td>
                                <td>@order.FullName</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-success fw-semibold">@order.TotalPrice.ToString("N0") VNĐ</td>
                                <td>
                                    <form asp-controller="Order" asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2 js-order-status-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <select name="orderStatus" class="form-select form-select-sm status-select">
                                            @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                                            {
                                                <option value="@status" selected="@(status == order.OrderStatus)">
                                                    @status.GetDisplayName()
                                                </option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-primary btn-sm btn-update">
                                            <i class="bi bi-arrow-repeat"></i> Cập nhật
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Order" asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-info btn-sm text-white">
                                        <i class="bi bi-file-earmark-text"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<!-- Animate.css (hiệu ứng mượt) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .table th, .table td {
        vertical-align: middle;
        padding: 12px 16px;
    }

    .table-dark th {
        background-color: #343a40;
        color: #fff;
        font-weight: 600;
    }

    .order-row:hover {
        background-color: #e9f7ef !important;
        cursor: pointer;
        box-shadow: inset 0 0 10px rgba(0, 123, 255, 0.1);
        transition: all 0.3s ease-in-out;
    }

    .btn {
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 10px rgba(0,0,0,0.15);
        }

    .btn-primary {
        background: linear-gradient(45deg, #007bff, #0056b3);
        border: none;
    }

    .btn-info {
        background: linear-gradient(45deg, #17a2b8, #0c6674);
        border: none;
    }

    .status-select {
        min-width: 130px;
        transition: box-shadow 0.3s ease;
    }

        .status-select:focus {
            box-shadow: 0 0 10px rgba(0, 123, 255, 0.4);
            border-color: #007bff;
        }

    .btn-update i {
        transition: transform 0.3s ease;
    }

    .btn-update:hover i {
        transform: rotate(360deg);
    }

    @@media (max-width: 768px) {
        .status-select

    {
        width: 100%;
    }

    .btn-update {
        width: 100%;
    }

    .d-flex.gap-2 {
        flex-direction: column;
    }

    }
</style>
