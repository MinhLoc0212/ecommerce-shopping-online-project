@model GearsHouse.Models.Order

@{
    ViewData["Title"] = "Checkout";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}

<style>
    /* Container flex chia 2 cột đều */
    .checkout-container {
        display: flex;
        align-items: flex-start;
        margin-top: 30px;
        gap: 30px;
        animation: fadeIn 1s ease forwards;
    }

    .checkout-products,
    .checkout-form {
        flex: 0 0 50%;
        max-width: 50%;
        box-sizing: border-box;
        padding: 0 15px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        transition: box-shadow 0.3s ease;
    }

        .checkout-products:hover,
        .checkout-form:hover {
            box-shadow: 0 12px 25px rgba(0,0,0,0.15);
        }

    /* Bảng sản phẩm */
    table {
        border-collapse: separate !important;
        border-spacing: 0 12px;
        width: 100%;
        font-size: 1rem;
    }

    thead tr th {
        background-color: #0d6efd;
        color: white;
        font-weight: 600;
        padding: 12px 15px;
        border-radius: 8px;
        text-align: center;
    }

    tbody tr {
        background: #f9faff;
        transition: background-color 0.3s ease;
        cursor: default;
        border-radius: 10px;
    }

        tbody tr:hover {
            background-color: #e3f0ff;
        }

        tbody tr td {
            vertical-align: middle !important;
            text-align: center;
            padding: 15px;
            border-radius: 8px;
        }

            tbody tr td img {
                max-width: 80px;
                max-height: 80px;
                object-fit: contain;
                border-radius: 8px;
                box-shadow: 0 3px 8px rgba(13, 110, 253, 0.2);
                transition: transform 0.3s ease;
            }

                tbody tr td img:hover {
                    transform: scale(1.05);
                }

    /* Form thanh toán */
    .checkout-form h2 {
        font-size: 1.8rem;
        margin-bottom: 10px;
        color: #0d6efd;
    }

    .checkout-form p.text-muted {
        font-size: 0.9rem;
        margin-bottom: 25px;
    }

    label.form-label {
        font-weight: 600;
        color: #212529;
    }

    input.form-control,
    select.form-select,
    textarea.form-control {
        border-radius: 8px;
        border: 1.5px solid #ced4da;
        transition: border-color 0.3s ease;
    }

        input.form-control:focus,
        select.form-select:focus,
        textarea.form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 8px rgba(13, 110, 253, 0.3);
        }

    button.btn {
        border-radius: 50px;
        font-weight: 600;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

    button.btn-success:hover {
        background-color: #084298;
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.4);
    }

    button.btn-outline-secondary:hover {
        background-color: #e9ecef;
        color: #0d6efd;
    }

    #onlinePaymentDetails {
        background-color: #f1f9ff;
        border: 1.5px solid #0d6efd;
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
    }

        #onlinePaymentDetails h4 {
            color: #0d6efd;
            margin-bottom: 15px;
        }

    /* Animation fade in */
    @@  keyframes fadeIn {
        0%

    {
        opacity: 0;
        transform: translateY(15px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<div class="checkout-container">

    <div class="checkout-products">
        <table>
            <thead>
                <tr>
                    <th><i class="bi bi-card-image"></i> Ảnh</th>
                    <th><i class="bi bi-box-seam"></i> Sản phẩm</th>
                    <th><i class="bi bi-basket3-fill"></i> Số lượng</th>
                    <th><i class="bi bi-currency-dollar"></i> Giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>
                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" />
                        </td>
                        <td>@item.Product.Name</td>
                        <td>@item.Quantity</td>
                        <td>@string.Format("{0:N0} VNĐ", item.Price)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="checkout-form">
        <h2 class="text-center text-uppercase fw-bold">
            <i class="bi bi-bag-check-fill"></i> 🛍️ Thanh toán
        </h2>
        <p class="text-center text-muted">Vui lòng nhập thông tin để hoàn tất đơn hàng</p>

        <form id="checkoutForm" asp-action="Checkout" method="post">
            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold">
                    <i class="bi bi-person-fill"></i> 👤 Họ và Tên
                </label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên của bạn..." required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label fw-semibold">
                    <i class="bi bi-telephone-fill"></i> 📞 Số điện thoại
                </label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại của bạn..." required />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ShippingAddress" class="form-label fw-semibold">
                    <i class="bi bi-geo-alt-fill"></i> 🏠 Địa chỉ giao hàng
                </label>
                <input asp-for="ShippingAddress" class="form-control" placeholder="Nhập địa chỉ của bạn..." required />
                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-semibold">
                    <i class="bi bi-journal-text"></i> 📝 Ghi chú (nếu có)
                </label>
                <textarea asp-for="Notes" class="form-control" placeholder="Nhập ghi chú cho đơn hàng..."></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label fw-semibold">
                    <i class="bi bi-credit-card-2-front-fill"></i> 💳 Phương thức thanh toán
                </label>
                <select asp-for="PaymentMethod" class="form-select" required onchange="togglePaymentOptions()">
                    <option value="">-- Chọn phương thức thanh toán --</option>
                    <option value="COD">Thanh toán khi nhận hàng (COD)</option>
                    <option value="Online">Thanh toán trực tuyến</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <div id="onlinePaymentDetails" style="display: none;">
                <h4 class="text-center">
                    <i class="bi bi-wallet2"></i> 💳 Thông tin thanh toán trực tuyến
                </h4>
                <p><strong>Ngân hàng:</strong> Ngân hàng ABC</p>
                <p><strong>Số tài khoản:</strong> 1234567890</p>
                <p><strong>Chủ tài khoản:</strong> Công ty XYZ</p>
                <p>
                    <strong>Hướng dẫn thanh toán:</strong><br />
                    Vui lòng chuyển khoản với nội dung: "<strong>HoVaTen_@(Model?.Id ?? 0)</strong>"
                </p>
                <div>
                    <label class="form-label fw-semibold">Mã QR thanh toán</label>
                    <img src="~/image/maqr.png" alt="Mã QR thanh toán" class="img-fluid rounded border" />
                    <p class="mt-2 text-muted">Quét mã QR để thanh toán trực tuyến.</p>
                </div>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-bag-check-fill"></i> Đặt hàng ngay
                </button>
            </div>
        </form>

        <form asp-controller="ShoppingCart" asp-action="CancelOrder" method="post" class="mt-3" onsubmit="disableValidation()">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left"></i> Quay lại giỏ hàng
            </button>
        </form>
    </div>

</div>

<script>
    function togglePaymentOptions() {
        var paymentMethod = document.querySelector('select[name="PaymentMethod"]').value;
        var onlinePaymentDetails = document.getElementById('onlinePaymentDetails');
        onlinePaymentDetails.style.display = (paymentMethod === 'Online') ? 'block' : 'none';
    }

    function disableValidation() {
        document.getElementById("checkoutForm").setAttribute("novalidate", "novalidate");
    }
</script>
