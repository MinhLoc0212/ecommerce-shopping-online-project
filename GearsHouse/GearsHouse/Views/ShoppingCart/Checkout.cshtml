@model GearsHouse.Models.Order

@{
    ViewData["Title"] = "Checkout";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}

<style>
    /* Container flex chia 2 cột đều */
    .checkout-container {
        display: flex;
        align-items: flex-start;
        margin-top: 30px;
        gap: 30px;
        animation: fadeIn 1s ease forwards;
    }

    .checkout-products,
    .checkout-form {
        flex: 0 0 50%;
        max-width: 50%;
        box-sizing: border-box;
        padding: 0 15px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
        transition: box-shadow 0.3s ease;
    }

    .checkout-products:hover,
    .checkout-form:hover {
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
    }

    /* Bảng sản phẩm */
    table {
        border-collapse: separate !important;
        border-spacing: 0 12px;
        width: 100%;
        font-size: 1rem;
    }

    thead tr th {
        background-color: #0d6efd;
        color: white;
        font-weight: 600;
        padding: 12px 15px;
        border-radius: 8px;
        text-align: center;
    }

    tbody tr {
        background: #f9faff;
        transition: background-color 0.3s ease;
        cursor: default;
        border-radius: 10px;
    }

    tbody tr:hover {
        background-color: #e3f0ff;
    }

    tbody tr td {
        vertical-align: middle !important;
        text-align: center;
        padding: 15px;
        border-radius: 8px;
    }

    tbody tr td img {
        max-width: 80px;
        max-height: 80px;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(13, 110, 253, 0.2);
        transition: transform 0.3s ease;
    }

    tbody tr td img:hover {
        transform: scale(1.05);
    }

    /* Form thanh toán */
    .checkout-form h2 {
        font-size: 1.8rem;
        margin-bottom: 10px;
        color: #0d6efd;
    }

    .checkout-form p.text-muted {
        font-size: 0.9rem;
        margin-bottom: 25px;
    }

    label.form-label {
        font-weight: 600;
        color: #212529;
    }

    input.form-control,
    select.form-select,
    textarea.form-control {
        border-radius: 8px;
        border: 1.5px solid #ced4da;
        transition: border-color 0.3s ease;
    }

    input.form-control:focus,
    select.form-select:focus,
    textarea.form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 8px rgba(13, 110, 253, 0.3);
    }

    button.btn {
        border-radius: 50px;
        font-weight: 600;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

    button.btn-success:hover {
        background-color: #084298;
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.4);
    }

    button.btn-outline-secondary:hover {
        background-color: #e9ecef;
        color: #0d6efd;
    }

    #onlinePaymentDetails {
        background-color: #f1f9ff;
        border: 1.5px solid #0d6efd;
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
    }

    #onlinePaymentDetails h4 {
        color: #0d6efd;
        margin-bottom: 15px;
    }

    /* Animation fade in */
    @@ keyframes fadeIn {
        0% {
            opacity: 0;
            transform: translateY(15px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }

    }
</style>

<div class="checkout-container">

    <div class="checkout-products">
        <table>
            <thead>
                <tr>
                    <th><i class="bi bi-card-image"></i> Ảnh</th>
                    <th><i class="bi bi-box-seam"></i> Sản phẩm</th>
                    <th><i class="bi bi-basket3-fill"></i> Số lượng</th>
                    <th><i class="bi bi-currency-dollar"></i> Giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)

                {
                    <tr>
                        <td>
                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" />
                        </td>
                        <td>@item.Product.Name</td>
                        <td>@item.Quantity</td>
                        <td>@string.Format("{0:N0} VNĐ", item.Price)</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="card mt-3 p-3" style="border: 1.5px solid #0d6efd; border-radius: 12px; background: #f1f9ff;">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">Tổng tiền gốc:</span>
                <span id="originalTotal" class="fw-bold text-danger">@Model.OrderDetails.Sum(i => i.Price *
                    i.Quantity).ToString("#,##0") VNĐ</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <span class="fw-bold">Giảm giá áp dụng:</span>
                <span id="discountAmount" class="fw-bold text-success">0 VNĐ</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">Tổng sau giảm:</span>
                <span id="finalTotal" class="fw-bold text-primary">@Model.OrderDetails.Sum(i => i.Price *
                    i.Quantity).ToString("#,##0") VNĐ</span>
            </div>
        </div>
    </div>

    <div class="checkout-form">
        <h2 class="text-center text-uppercase fw-bold">
            <i class="bi bi-bag-check-fill"></i> 🛍️ Thanh toán
        </h2>
        <p class="text-center text-muted">Vui lòng nhập thông tin để hoàn tất đơn hàng</p>

        <form id="checkoutForm" asp-action="Checkout" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold">
                    <i class="bi bi-person-fill"></i> 👤 Họ và Tên
                </label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên của bạn..." required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label fw-semibold">
                    <i class="bi bi-telephone-fill"></i> 📞 Số điện thoại
                </label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại của bạn..."
                    required />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-geo-alt-fill"></i> 🏠 Địa chỉ giao hàng
                </label>
                <div class="row g-2">
                    <div class="col-12">
                        <input id="streetAddress" class="form-control" placeholder="Số nhà, đường..." required />
                    </div>
                    <div class="col-md-6">
                        <select id="provinceSelect" class="form-select" required>
                            <option value="">-- Chọn Tỉnh/Thành phố --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <select id="districtSelect" class="form-select" required disabled>
                            <option value="">-- Chọn Quận/Huyện --</option>
                        </select>
                    </div>
                </div>
                <input asp-for="ShippingAddress" type="hidden" />
                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-semibold">
                    <i class="bi bi-journal-text"></i> 📝 Ghi chú (nếu có)
                </label>
                <textarea asp-for="Notes" class="form-control" placeholder="Nhập ghi chú cho đơn hàng..."></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="CouponCode" class="form-label fw-semibold">
                    <i class="bi bi-ticket-perforated"></i> 🎫 Mã giảm giá (tuỳ chọn)
                </label>
                <div class="input-group">
                    @{
                        var couponDisabled = ViewBag.HasPromo == true ? "disabled" : null;
                    }
                    <input asp-for="CouponCode" class="form-control" placeholder="Nhập mã nếu có..."
                        disabled="@couponDisabled" />
                    <button type="button" class="btn btn-primary" onclick="applyCoupon()" @(ViewBag.HasPromo == true ?
                        "disabled" : "")>Áp dụng</button>
                </div>
                <span asp-validation-for="CouponCode" class="text-danger"></span>
                <div id="couponMessage" class="mt-2">
                    @if (ViewBag.HasPromo == true)

                    {
                        <div class="alert alert-info py-2">Không áp dụng mã giảm giá cho sản phẩm đang được khuyến mãi</div>
                    }
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label fw-semibold">
                    <i class="bi bi-credit-card-2-front-fill"></i> 💳 Phương thức thanh toán
                </label>
                <select asp-for="PaymentMethod" class="form-select" required onchange="togglePaymentOptions()">
                    <option value="">-- Chọn phương thức thanh toán --</option>
                    <option value="COD">Thanh toán khi nhận hàng (COD)</option>
                    <option value="VNPay">Thanh toán qua VNPay</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <div id="vnpayPaymentDetails" style="display: none;">
                <h4 class="text-center">
                    <i class="bi bi-wallet2"></i> 💳 Thanh toán qua VNPay
                </h4>
                <p class="text-muted text-center">Bạn sẽ được chuyển đến cổng VNPay để thanh toán an toàn.</p>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-bag-check-fill"></i> Đặt hàng ngay
                </button>
            </div>
        </form>

        @if (Model.Id > 0)

        {
            <form asp-controller="ShoppingCart" asp-action="CancelOrder" method="post" class="mt-3"
                onsubmit="disableValidation()">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Quay lại giỏ hàng
                </button>
            </form>
        }

        else

        {
            <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-outline-secondary btn-lg mt-3">
                <i class="bi bi-arrow-left"></i> Quay lại giỏ hàng
            </a>
        }
    </div>

</div>

<script>
    function togglePaymentOptions() {
        var paymentMethod = document.querySelector('select[name="PaymentMethod"]').value;
        var vnpayPaymentDetails = document.getElementById('vnpayPaymentDetails');
        vnpayPaymentDetails.style.display = (paymentMethod === 'VNPay') ? 'block' : 'none';
    }

    document.addEventListener('DOMContentLoaded', () => {
        const provinceSelect = document.getElementById('provinceSelect');
        const districtSelect = document.getElementById('districtSelect');
        const streetInput = document.getElementById('streetAddress');
        const shippingHidden = document.querySelector('input[name="ShippingAddress"]');

        let provinces = [];

        fetch('https://provinces.open-api.vn/api/?depth=2')
            .then(r => r.json())
            .then(data => {
                provinces = data || [];
                provinceSelect.innerHTML = '<option value="">-- Chọn Tỉnh/Thành phố --</option>' +
                    provinces.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
            })
            .catch(() => {
                provinceSelect.innerHTML = '<option value="">Không tải được danh sách tỉnh/thành</option>';
            });

        provinceSelect.addEventListener('change', () => {
            const selected = provinces.find(p => p.name === provinceSelect.value);
            if (!selected) {
                districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                districtSelect.disabled = true;
            } else {
                districtSelect.disabled = false;
                districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>' +
                    (selected.districts || []).map(d => `<option value="${d.name}">${d.name}</option>`).join('');
            }
            updateShippingAddress();
        });

        districtSelect.addEventListener('change', updateShippingAddress);
        streetInput.addEventListener('input', updateShippingAddress);

        document.getElementById('checkoutForm').addEventListener('submit', (e) => {
            updateShippingAddress();
            if (!shippingHidden.value.trim()) {
                e.preventDefault();
                alert('Vui lòng nhập địa chỉ đầy đủ, chọn Tỉnh/Thành phố và Quận/Huyện.');
            }
        });

        function updateShippingAddress() {
            const parts = [streetInput.value.trim()];
            if (districtSelect.value) parts.push(districtSelect.value.trim());
            if (provinceSelect.value) parts.push(provinceSelect.value.trim());
            shippingHidden.value = parts.filter(Boolean).join(', ');
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        const provinceSelect = document.getElementById('provinceSelect');
        const districtSelect = document.getElementById('districtSelect');
        const streetInput = document.getElementById('streetAddress');
        const shippingHidden = document.querySelector('input[name="ShippingAddress"]');

        let provinces = [];

        fetch('https://provinces.open-api.vn/api/?depth=2')
            .then(r => r.json())
            .then(data => {
                provinces = data || [];
                provinceSelect.innerHTML = '<option value="">-- Chọn Tỉnh/Thành phố --</option>' +
                    provinces.map(p => `<option value="${p.name}">${p.name}</option>`).join('');
            })
            .catch(() => {
                provinceSelect.innerHTML = '<option value="">Không tải được danh sách tỉnh/thành</option>';
            });

        provinceSelect.addEventListener('change', () => {
            const selected = provinces.find(p => p.name === provinceSelect.value);
            if (!selected) {
                districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                districtSelect.disabled = true;
            } else {
                districtSelect.disabled = false;
                districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>' +
                    (selected.districts || []).map(d => `<option value="${d.name}">${d.name}</option>`).join('');
            }
            updateShippingAddress();
        });

        districtSelect.addEventListener('change', updateShippingAddress);
        streetInput.addEventListener('input', updateShippingAddress);

        document.getElementById('checkoutForm').addEventListener('submit', (e) => {
            updateShippingAddress();
            if (!shippingHidden.value.trim()) {
                e.preventDefault();
                alert('Vui lòng nhập địa chỉ đầy đủ, chọn Tỉnh/Thành phố và Quận/Huyện.');
            }
        });

        function updateShippingAddress() {
            const parts = [streetInput.value.trim()];
            if (districtSelect.value) parts.push(districtSelect.value.trim());
            if (provinceSelect.value) parts.push(provinceSelect.value.trim());
            shippingHidden.value = parts.filter(Boolean).join(', ');
        }
    });

    function disableValidation() {
        document.getElementById("checkoutForm").setAttribute("novalidate", "novalidate");
    }

    function formatCurrencyVND(value) {
        try {
            return Number(value).toLocaleString('vi-VN') + ' VNĐ';
        } catch (e) {
            return value + ' VNĐ';
        }
    }

    async function applyCoupon() {
        const input = document.querySelector('input[name="CouponCode"]');
        const code = (input.value || '').trim().toUpperCase();
        const messageBox = document.getElementById('couponMessage');
        messageBox.innerHTML = '';

        if (!code) {
            messageBox.innerHTML = '<div class="alert alert-warning py-2">Vui lòng nhập mã giảm giá.</div>';
            return;
        }

        const originalTotal = @Model.OrderDetails.Sum(i => i.Price * i.Quantity);

        try {
            const resp = await fetch('/ShoppingCart/ApplyCoupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ code: code, orderId: '@Model.Id' })
            });
            const data = await resp.json();
            if (data.success) {
                document.getElementById('discountAmount').innerText = formatCurrencyVND(data.discountAmount);
                document.getElementById('finalTotal').innerText = formatCurrencyVND(data.finalTotal);
                messageBox.innerHTML = '<div class="alert alert-success py-2">Áp dụng mã thành công!</div>';
            } else {
                // reset discount view
                document.getElementById('discountAmount').innerText = formatCurrencyVND(0);
                document.getElementById('finalTotal').innerText = formatCurrencyVND(originalTotal);
                const alertClass = data.used ? 'alert-danger' : 'alert-warning';
                messageBox.innerHTML = `<div class="${alertClass} py-2">${data.message || 'Mã giảm giá không hợp lệ.'}</div>`;
            }
        } catch (err) {
            messageBox.innerHTML = '<div class="alert alert-danger py-2">Có lỗi khi áp dụng mã. Vui lòng thử lại.</div>';
        }
    }
</script>
