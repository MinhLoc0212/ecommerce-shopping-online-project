@model GearsHouse.Models.ShoppingCart

    @{
        int? lastProductId = Context.Session.GetInt32("LastProductId");
    }

    <div class="container my-5">
        <h2 class="text-center mb-4 fw-bold text-uppercase">🛒 Giỏ hàng của bạn</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle shadow-sm">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Sản phẩm</th>
                            
                            <th scope="col">Số lượng</th>
                            <th scope="col">Đơn giá</th>
                            <th scope="col">Tổng</th>
                            <th scope="col">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                            <td class="d-flex align-items-center gap-3">
                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" />
                                <strong>@item.Name</strong>
                            </td>

                             
                            <td>
                                <div class="input-group w-50">
                                    <form asp-controller="ShoppingCart" asp-action="DecreaseQuantity" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        
                                        <button type="submit" class="btn btn-outline-secondary">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </form>

                                    <input type="number" class="form-control text-center" value="@item.Quantity" readonly>

                                    <form asp-controller="ShoppingCart" asp-action="IncreaseQuantity" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        
                                        <button type="submit" class="btn btn-outline-secondary">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>

                                <td>
                                    @if (item.Price < item.OriginalPrice)
                                    {
                                        <span class="text-danger fw-bold">@item.Price.ToString("#,##0") VND</span>

                                        <br />
                                        <span class="text-muted text-decoration-line-through">@item.OriginalPrice.ToString("#,##0") VND</span>
                                    }
                                    else
                                    {
                                        <span>@item.Price.ToString("#,##0") VND</span>
                                    }
                                </td>
                                <td>@((item.Price * item.Quantity).ToString("#,##0")) VND</td>
                                <td>
                                    <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId"  class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng không?');">
                                        <i class="fas fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card mt-4 p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0">Tổng tiền:</h4>
                    <h4 class="text-danger fw-bold">@Model.Items.Sum(i => i.Price * i.Quantity).ToString("#,##0") VND</h4>
                </div>
                <div class="text-end mt-3">
                    <form asp-controller="ShoppingCart" asp-action="CreateOrder" method="post">
                        <button type="submit" class="btn btn-success btn-lg">🛍️ Thanh toán ngay</button>
                    </form>


                    @if (lastProductId.HasValue)
                    {
                        <a asp-controller="Product" asp-action="Display" asp-route-id="@lastProductId" class="btn btn-outline-secondary btn-lg ms-2">
                            <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-lg ms-2">
                            <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-shopping-cart fa-5x text-muted"></i>
                <h3 class="mt-3 text-muted">Giỏ hàng của bạn đang trống!</h3>
                @if (lastProductId.HasValue)
                {
                    <a asp-controller="Product" asp-action="Index" asp-route-id="@lastProductId" class="btn btn-primary mt-3">
                        <i class="fas fa-arrow-left me-2"></i> Quay lại mua sắm
                    </a>
                }
                else
                {
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">
                        <i class="fas fa-arrow-left me-2"></i> Quay lại mua sắm
                    </a>
                }
            </div>
        }
    </div>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
